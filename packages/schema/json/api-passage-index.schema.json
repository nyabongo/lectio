{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyabongo/lectio/schema/api-passage-index.schema.json",
  "title": "Lectio API v1 passage index",
  "description": "Every passage with approved notes (/api/v1/passages/index.json), sorted by key.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "passages"],
  "properties": {
    "apiVersion": { "const": 1 },
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "ref", "summary", "lastReviewedAt", "dates"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^([1-3]?[A-Z]{2,5}\\.[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?(_[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?)*|EST\\.([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?(_([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?)*)$",
            "maxLength": 120
          },
          "ref": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
          "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 140 },
          "lastReviewedAt": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
          "dates": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }
          }
        }
      }
    }
  }
}
