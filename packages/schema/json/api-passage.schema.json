{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyabongo/lectio/schema/api-passage.schema.json",
  "title": "Lectio API v1 passage",
  "description": "The approved notes for one passage (/api/v1/passages/{key}.json) and every calendar date it is read on. Never contains the reading text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "passage", "dates"],
  "properties": {
    "apiVersion": { "const": 1 },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "ref", "locale", "summary", "context", "translationNotes", "claims", "sources", "review"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^([1-3]?[A-Z]{2,5}\\.[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?(_[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?)*|EST\\.([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?(_([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?)*)$",
          "maxLength": 120
        },
        "ref": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$" },
        "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 140 },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "paragraphs", "audio"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
            "paragraphs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^([^\\[\\]]+(\\[c[1-9][0-9]*\\])+)+$" }
            },
            "audio": {
              "anyOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["url", "durationSeconds"],
                  "properties": {
                    "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
                    "durationSeconds": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
                  }
                }
              ]
            }
          }
        },
        "translationNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "verse", "anchor", "original", "summary", "body", "audio"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
              "verse": { "type": "string", "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$" },
              "anchor": { "type": "string", "pattern": "^\\S+( \\S+){0,5}$", "maxLength": 80 },
              "original": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text", "lang", "translit", "gloss"],
                "properties": {
                  "text": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                  "lang": { "type": "string", "enum": ["grc", "hbo", "arc", "lat"] },
                  "translit": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                  "gloss": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
                }
              },
              "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 200 },
              "body": { "type": "string", "pattern": "^([^\\[\\]]+(\\[c[1-9][0-9]*\\])+)+$" },
              "audio": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "durationSeconds"],
                    "properties": {
                      "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
                      "durationSeconds": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
                    }
                  }
                ]
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text", "sourceIds", "sensitive"],
            "properties": {
              "id": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
              "text": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
              "sourceIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 }
              },
              "sensitive": { "type": "boolean" }
            }
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "citation"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
              "type": { "type": "string", "enum": ["scripture", "web", "print"] },
              "citation": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
              "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
              "archivedUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
              "ref": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
              "excerpt": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
              "excerptLang": {
                "anyOf": [
                  { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$" },
                  { "type": "string", "enum": ["grc", "hbo", "arc", "lat"] }
                ]
              },
              "retrievedAt": { "type": "string", "format": "date-time" }
            },
            "dependentRequired": { "excerptLang": ["excerpt"] },
            "allOf": [
              { "if": { "properties": { "type": { "const": "scripture" } } }, "then": { "required": ["ref"] } },
              { "if": { "properties": { "type": { "const": "web" } } }, "then": { "required": ["url", "retrievedAt"] } }
            ]
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "method", "lastReviewedAt"],
          "properties": {
            "status": { "const": "approved" },
            "method": { "type": "string", "enum": ["human", "auto"] },
            "lastReviewedAt": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] }
          }
        }
      }
    },
    "dates": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" }
    }
  }
}
