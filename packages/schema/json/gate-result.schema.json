{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyabongo/lectio/schema/gate-result.schema.json",
  "title": "Lectio gate result",
  "description": "The outcome of one content gate on a pull request, with one item per finding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate", "status", "items", "meta"],
  "properties": {
    "gate": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "status": { "type": "string", "enum": ["pass", "fail", "flag", "skipped"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "severity", "pointer", "message"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "file": { "type": "string", "pattern": "^[^/\\\\].*$" },
          "pointer": { "type": "string", "pattern": "^(/([^~/]|~[01])*)*$" },
          "claimId": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
          "message": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        }
      }
    },
    "meta": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "pass" } } },
      "then": {
        "properties": {
          "items": {
            "not": {
              "type": "array",
              "contains": { "type": "object", "properties": { "severity": { "const": "error" } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "fail" } } },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "contains": { "type": "object", "properties": { "severity": { "const": "error" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "flag" } } },
      "then": { "properties": { "items": { "type": "array", "minItems": 1 } } }
    }
  ]
}
