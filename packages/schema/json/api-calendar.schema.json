{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyabongo/lectio/schema/api-calendar.schema.json",
  "title": "Lectio API v1 calendar year",
  "description": "Every day of one civil year (/api/v1/calendar/{year}.json) with its readings, whether each has notes, and their one-line summary.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "year", "region", "days"],
  "properties": {
    "apiVersion": { "const": 1 },
    "year": { "type": "integer", "minimum": 1970, "maximum": 9999 },
    "region": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "season",
          "seasonWeek",
          "sundayCycle",
          "weekdayCycle",
          "colour",
          "celebrations",
          "lectionaryMissing",
          "masses"
        ],
        "properties": {
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "format": "date" },
          "season": {
            "type": "string",
            "enum": ["advent", "christmas", "ordinary-time", "lent", "paschal-triduum", "easter"]
          },
          "seasonWeek": { "type": "integer", "minimum": 0, "maximum": 34 },
          "sundayCycle": { "type": "string", "enum": ["A", "B", "C"] },
          "weekdayCycle": { "type": "string", "enum": ["I", "II"] },
          "colour": { "type": "string", "enum": ["white", "red", "green", "violet", "rose", "black", "gold"] },
          "celebrations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "rank", "colour"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
                "name": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                "names": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["en", "sw"],
                  "properties": {
                    "en": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                    "sw": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                    "swStatus": { "type": "string", "enum": ["provisional", "reviewed", "fallback"] }
                  }
                },
                "rank": {
                  "type": "string",
                  "enum": ["solemnity", "sunday", "feast", "memorial", "optional-memorial", "commemoration", "weekday"]
                },
                "colour": { "type": "string", "enum": ["white", "red", "green", "violet", "rose", "black", "gold"] }
              }
            }
          },
          "lectionaryMissing": { "type": "boolean" },
          "masses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "label", "readings"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
                "label": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                "readings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["slot", "ref", "key", "linkout", "hasNotes", "summary"],
                    "properties": {
                      "slot": {
                        "type": "string",
                        "enum": [
                          "first-reading",
                          "psalm",
                          "second-reading",
                          "gospel",
                          "reading-1",
                          "reading-2",
                          "reading-3",
                          "reading-4",
                          "reading-5",
                          "reading-6",
                          "reading-7",
                          "reading-8",
                          "reading-9",
                          "psalm-1",
                          "psalm-2",
                          "psalm-3",
                          "psalm-4",
                          "psalm-5",
                          "psalm-6",
                          "psalm-7",
                          "psalm-8",
                          "psalm-9",
                          "epistle"
                        ]
                      },
                      "ref": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
                      "key": {
                        "type": "string",
                        "pattern": "^([1-3]?[A-Z]{2,5}\\.[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?(_[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?)*|EST\\.([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?(_([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?)*)$",
                        "maxLength": 120
                      },
                      "linkout": { "type": "string", "format": "uri", "pattern": "^https?://" },
                      "hasNotes": { "type": "boolean" },
                      "summary": {
                        "anyOf": [
                          { "type": "null" },
                          { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 140 }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
