{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyabongo/lectio/schema/translated-passage.schema.json",
  "title": "Lectio translated passage",
  "description": "The commentary of one passage in another language (passages/i18n/<locale>/<key>.json). Ids are reused from the English file; sources are not translated. Never contains the reading text.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": { "not": { "enum": ["text", "verses"] } },
  "required": [
    "translationOf",
    "locale",
    "sourceSha256",
    "summary",
    "context",
    "translationNotes",
    "claims",
    "provenance",
    "review",
    "schemaVersion"
  ],
  "properties": {
    "translationOf": {
      "type": "string",
      "pattern": "^([1-3]?[A-Z]{2,5}\\.[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?(_[1-9][0-9]{0,2}(-[1-9][0-9]{0,2}|\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)?)*|EST\\.([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?(_([1-9][0-9]{0,2}|[A-F])(-([1-9][0-9]{0,2}|[A-F])|\\.[1-9][0-9]{0,2}(-(([1-9][0-9]{0,2}|[A-F])\\.)?[1-9][0-9]{0,2})?)?)*)$",
      "maxLength": 120
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$",
      "not": { "type": "string", "pattern": "^en(-|$)" }
    },
    "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 200 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^([^\\[\\]]+(\\[c[1-9][0-9]*\\])+)+$" }
        }
      }
    },
    "translationNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "gloss", "summary", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "anchor": { "type": "string", "pattern": "^\\S+( \\S+){0,5}$", "maxLength": 80 },
          "gloss": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
          "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 240 },
          "body": { "type": "string", "pattern": "^([^\\[\\]]+(\\[c[1-9][0-9]*\\])+)+$" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "runId", "models", "promptVersion", "createdAt"],
      "properties": {
        "generator": { "type": "string", "enum": ["research-cli", "manual-seed", "fake"] },
        "runId": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        },
        "promptVersion": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "costUsd": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "generator": { "const": "research-cli" } } },
          "then": { "properties": { "models": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "method": { "type": "string", "const": "human" },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        },
        "approvedVia": { "type": "string", "enum": ["cli", "label", "comment"] },
        "lastReviewedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": {
            "required": ["method", "approvedVia"],
            "properties": { "reviewers": { "type": "array", "minItems": 1 } }
          },
          "else": { "not": { "anyOf": [{ "required": ["method"] }, { "required": ["approvedVia"] }] } }
        }
      ]
    },
    "schemaVersion": { "const": 1 }
  }
}
