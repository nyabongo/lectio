{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nyabongo/lectio/schema/passage.schema.json",
  "title": "Lectio passage",
  "description": "Commentary for one passage (passages/<key>.json). Never contains the reading text: only references, link-outs, commentary, claims and sources.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": { "not": { "enum": ["text", "verses"] } },
  "required": [
    "key",
    "ref",
    "locale",
    "summary",
    "context",
    "translationNotes",
    "claims",
    "sources",
    "provenance",
    "review",
    "schemaVersion"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[1-3]?[A-Z]{2,5}\\.[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?(_[1-9][0-9]{0,2}\\.[1-9][0-9]{0,2}(-([1-9][0-9]{0,2}\\.)?[1-9][0-9]{0,2})?)*$",
      "maxLength": 120
    },
    "ref": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$" },
    "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 140 },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^([^\\[\\]]+(\\[c[1-9][0-9]*\\])+)+$" }
        }
      }
    },
    "translationNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verse", "anchor", "original", "summary", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "verse": { "type": "string", "pattern": "^[1-9][0-9]{0,2}:[1-9][0-9]{0,2}$" },
          "anchor": { "type": "string", "pattern": "^\\S+( \\S+){0,5}$", "maxLength": 80 },
          "original": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "lang", "translit", "gloss"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
              "lang": { "type": "string", "enum": ["grc", "hbo", "lat"] },
              "translit": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
              "gloss": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
            }
          },
          "summary": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$", "maxLength": 200 },
          "body": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "sourceIds", "sensitive"],
        "properties": {
          "id": { "type": "string", "pattern": "^c[1-9][0-9]*$" },
          "text": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 }
          },
          "sensitive": { "type": "boolean" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "citation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
          "type": { "type": "string", "enum": ["scripture", "web", "print"] },
          "citation": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "archivedUrl": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "ref": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
          "excerpt": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
          "excerptLang": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$" },
              { "type": "string", "enum": ["grc", "hbo", "lat"] }
            ]
          },
          "retrievedAt": { "type": "string", "format": "date-time" }
        },
        "dependentRequired": { "excerptLang": ["excerpt"] },
        "allOf": [
          { "if": { "properties": { "type": { "const": "scripture" } } }, "then": { "required": ["ref"] } },
          { "if": { "properties": { "type": { "const": "web" } } }, "then": { "required": ["url", "retrievedAt"] } }
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "runId", "models", "promptVersion", "createdAt"],
      "properties": {
        "generator": { "type": "string", "enum": ["research-cli", "manual-seed", "fake"] },
        "runId": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        },
        "promptVersion": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "costUsd": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "generator": { "const": "research-cli" } } },
          "then": { "properties": { "models": { "type": "array", "minItems": 1 } } }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewers"],
      "properties": {
        "status": { "type": "string", "enum": ["pending", "approved"] },
        "method": { "type": "string", "enum": ["human", "auto"] },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" }
        },
        "approvedVia": { "type": "string", "enum": ["cli", "label", "comment", "auto"] },
        "lastReviewedAt": { "type": "string", "format": "date-time" },
        "verifierSummary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["confirmer", "refuter", "minSupport", "refutations", "sensitive"],
          "properties": {
            "confirmer": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
            "refuter": { "type": "string", "minLength": 1, "pattern": "^\\S(.*\\S)?$" },
            "minSupport": { "type": "number", "minimum": 0, "maximum": 1 },
            "refutations": { "type": "integer", "minimum": 0 },
            "sensitive": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": { "required": ["method", "approvedVia"] },
          "else": { "not": { "anyOf": [{ "required": ["method"] }, { "required": ["approvedVia"] }] } }
        },
        {
          "if": { "required": ["method"], "properties": { "method": { "const": "auto" } } },
          "then": { "required": ["verifierSummary"], "properties": { "approvedVia": { "const": "auto" } } }
        },
        {
          "if": { "required": ["method"], "properties": { "method": { "const": "human" } } },
          "then": {
            "properties": {
              "approvedVia": { "enum": ["cli", "label", "comment"] },
              "reviewers": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "schemaVersion": { "const": 1 }
  }
}
