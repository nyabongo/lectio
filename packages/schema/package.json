{
  "name": "@lectio/schema",
  "version": "0.0.0",
  "private": true,
  "description": "Content JSON schemas (passage, calendar, gate result) with ajv validators.",
  "type": "module",
  "exports": {
    "./*": "./src/*/index.ts",
    "./json/*": "./json/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "schema:emit": "tsx ../../scripts/run-planned.mjs L-004 src/cli/emit.ts"
  },
  "dependencies": {
    "@lectio/shared": "0.0.0",
    "ajv": "^8.20.0",
    "json-schema-to-ts": "^3.1.1"
  }
}
