{
  "name": "@lectio/calendar",
  "version": "0.0.0",
  "private": true,
  "description": "Liturgical calendar (romcal + regional overrides + lectionary) and calendar CLIs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "calendar:build": "tsx ../../scripts/run-planned.mjs L-017 src/cli/build.ts",
    "calendar:check": "tsx ../../scripts/run-planned.mjs L-017 src/cli/check.ts",
    "calendar:report": "tsx ../../scripts/run-planned.mjs L-070 src/report/cli.ts"
  },
  "dependencies": {
    "@lectio/shared": "0.0.0",
    "@lectio/config": "0.0.0",
    "@lectio/schema": "0.0.0",
    "@lectio/refs": "0.0.0",
    "@lectio/lectionary": "0.0.0",
    "romcal": "3.0.0-dev.140",
    "@romcal/calendar.general-roman": "3.0.0-dev.140"
  }
}
