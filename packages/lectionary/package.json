{
  "name": "@lectio/lectionary",
  "version": "0.0.0",
  "private": true,
  "description": "Lectionary reference data format, resolver and cross-check tools.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lectionary:check": "tsx ../../scripts/run-planned.mjs L-016 src/cli/check.ts",
    "lectionary:crosscheck": "tsx ../../scripts/run-planned.mjs L-016 src/cli/crosscheck.ts"
  },
  "dependencies": {
    "@lectio/shared": "0.0.0",
    "@lectio/schema": "0.0.0",
    "@lectio/refs": "0.0.0"
  }
}
