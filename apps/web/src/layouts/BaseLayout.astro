---
/**
 * The base layout every page uses: document head, the day's liturgical colour band, the header (date title,
 * calendar, search and settings links), the main slot and the footer (study-aid disclaimer, about link).
 *
 * Colour: `colour` sets `<html data-colour>`, which swaps the accent tokens generated by `themeCss()`
 * (src/lib/theme.ts). The scheme follows the system unless `<html data-theme>` overrides it: the inline
 * `headScript()` (src/lib/settings.ts, L-057) applies the reader's saved theme and text size before first paint.
 *
 * Header and footer strings come from `src/i18n/<lang>/common.json` (L-051) and links are locale-prefixed with
 * `localePath`; the nav ends with the language switcher (L-110); slots `head` (extra head elements, e.g. the SEO
 * component of L-058) and `header-actions` (extra header controls) let pages add to both.
 *
 * PWA (L-061): the manifest, theme colour and icons are linked here, and `PwaUpdate` registers the service worker
 * and holds the update-available toast.
 */
import '../styles/global.css';

import LocaleSwitcher from '../components/locale-switcher/LocaleSwitcher.astro';
import PwaUpdate from '../components/pwa/PwaUpdate.astro';
import { DEFAULT_LOCALE, formatDate, localePath, t } from '../i18n/index.ts';
import { headScript } from '../lib/settings.ts';
import { ACCENTS, DEFAULT_COLOUR, colourAttribute, themeCss } from '../lib/theme.ts';
import { withBase } from '../lib/site.ts';

export interface Props {
  /** The document title; ` · Lectio` is appended unless it is already the site name. */
  title: string;
  /** Meta description. */
  description?: string;
  /** The liturgical day the page is about (`YYYY-MM-DD`): shown as the header's date title. */
  date?: string;
  /** The day's celebration, shown under the date title. */
  celebration?: string;
  /** The celebration name's language when it is not the page's (an untranslated English name). */
  celebrationLang?: string | undefined;
  /** Liturgical colour of the day (`green`, `violet`, `white`, `gold`, `red`, `rose`, `black`). */
  colour?: string;
  /** Page language (a locale with catalogs in `src/i18n/`); defaults to `en`. */
  lang?: string;
}

const { title, description, date, celebration, celebrationLang, colour, lang = DEFAULT_LOCALE } = Astro.props;
const base = import.meta.env.BASE_URL;
const siteName = t(lang, 'common.site.name');
const fullTitle = title === siteName ? title : t(lang, 'common.site.pageTitle', { title });
const dataColour = colourAttribute(colour);
const dateTitle = date === undefined ? undefined : formatDate(lang, date);
const links = {
  home: withBase(base, localePath(lang)),
  calendar: withBase(base, localePath(lang, 'calendar/')),
  search: withBase(base, localePath(lang, 'search/')),
  settings: withBase(base, localePath(lang, 'settings/')),
  about: withBase(base, localePath(lang, 'about/')),
};
---

<!doctype html>
<html lang={lang} data-colour={dataColour}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={ACCENTS.light[DEFAULT_COLOUR].accent} />
    <link rel="manifest" href={withBase(base, 'manifest.webmanifest')} />
    <link rel="icon" href={withBase(base, 'icons/icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase(base, 'icons/apple-touch-icon.png')} />
    <title>{fullTitle}</title>
    {description !== undefined && <meta name="description" content={description} />}
    <link rel="preload" href={withBase(base, 'fonts/source-sans-3-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase(base, 'fonts/cormorant-garamond-latin-600-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={themeCss()} />
    <script is:inline set:html={headScript()} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'common.skipLink')}</a>
    <div class="band" aria-hidden="true"></div>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={links.home}>{siteName}</a>
        {
          dateTitle !== undefined && (
            <p class="date-title">
              <time datetime={date}>{dateTitle}</time>
              {celebration !== undefined && <span class="celebration" lang={celebrationLang}>{celebration}</span>}
            </p>
          )
        }
        <nav class="site-nav" aria-label={t(lang, 'common.nav.label')}>
          <a href={links.calendar}>{t(lang, 'common.nav.calendar')}</a>
          <a href={links.search}>{t(lang, 'common.nav.search')}</a>
          <a href={links.settings}>{t(lang, 'common.nav.settings')}</a>
          <LocaleSwitcher lang={lang} />
          <slot name="header-actions" />
        </nav>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="disclaimer">{t(lang, 'common.footer.disclaimer')}</p>
        <p><a href={links.about}>{t(lang, 'common.footer.about')}</a></p>
      </div>
    </footer>
    <PwaUpdate lang={lang} />
  </body>
</html>

<style>
  .band {
    height: var(--band-height);
    background: var(--colour-accent);
  }

  .site-header {
    background: var(--colour-surface);
    border-bottom: var(--rule-width) solid var(--colour-rule);
  }

  .site-header__inner,
  .site-footer__inner,
  .site-main {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-xs);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-strong);
    color: var(--colour-ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .date-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: var(--leading-snug);
    max-width: none;
  }

  .date-title time {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-strong);
  }

  .celebration {
    font-size: var(--step--1);
    color: var(--colour-accent-ink);
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0 var(--space-2xs);
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    color: var(--colour-ink);
    text-decoration: none;
    border-radius: var(--radius-m);
    transition: background-color var(--duration-quick) var(--ease-out);
  }

  .site-nav a:hover {
    background: var(--colour-wash);
  }

  .site-main {
    flex: 1;
    padding-block: var(--space-l) var(--space-xl);
  }

  .site-footer {
    background: var(--colour-wash);
    border-top: var(--rule-width) solid var(--colour-rule);
    color: var(--colour-muted);
    font-size: var(--step--1);
  }

  .site-footer__inner {
    padding-block: var(--space-m);
  }

  .site-footer p:last-child {
    margin-bottom: 0;
  }

  .site-footer a {
    color: var(--colour-link);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .date-title {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
