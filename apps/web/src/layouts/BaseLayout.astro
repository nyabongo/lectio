---
/**
 * The base layout every page uses: document head, the day's liturgical colour band, the header (date title,
 * calendar and settings links), the main slot and the footer (study-aid disclaimer, about link).
 *
 * Colour: `colour` sets `<html data-colour>`, which swaps the accent tokens generated by `themeCss()`
 * (src/lib/theme.ts). The scheme follows the system unless `<html data-theme>` overrides it (L-054 sets it).
 *
 * Header and footer strings are English until the i18n catalog (L-048) replaces them; slots `head` (extra head
 * elements, e.g. the SEO component of L-055) and `header-actions` (extra header controls) let pages add to both.
 */
import '../styles/global.css';

import { colourAttribute, themeCss } from '../lib/theme.ts';
import { formatDateTitle, withBase } from '../lib/site.ts';

export interface Props {
  /** The document title; ` · Lectio` is appended unless it is already `Lectio`. */
  title: string;
  /** Meta description. */
  description?: string;
  /** The liturgical day the page is about (`YYYY-MM-DD`): shown as the header's date title. */
  date?: string;
  /** The day's celebration, shown under the date title. */
  celebration?: string;
  /** Liturgical colour of the day (`green`, `violet`, `white`, `gold`, `red`, `rose`, `black`). */
  colour?: string;
  /** Page language; defaults to `en`. */
  lang?: string;
}

const { title, description, date, celebration, colour, lang = 'en' } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullTitle = title === 'Lectio' ? title : `${title} · Lectio`;
const dataColour = colourAttribute(colour);
const dateTitle = date === undefined ? undefined : formatDateTitle(date, lang);
const links = {
  home: withBase(base),
  calendar: withBase(base, 'calendar/'),
  settings: withBase(base, 'settings/'),
  about: withBase(base, 'about/'),
};
---

<!doctype html>
<html lang={lang} data-colour={dataColour}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {description !== undefined && <meta name="description" content={description} />}
    <link rel="preload" href={withBase(base, 'fonts/source-sans-3-latin-400-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase(base, 'fonts/cormorant-garamond-latin-600-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={themeCss()} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="band" aria-hidden="true"></div>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href={links.home}>Lectio</a>
        {
          dateTitle !== undefined && (
            <p class="date-title">
              <time datetime={date}>{dateTitle}</time>
              {celebration !== undefined && <span class="celebration">{celebration}</span>}
            </p>
          )
        }
        <nav class="site-nav" aria-label="Site">
          <a href={links.calendar}>Calendar</a>
          <a href={links.settings}>Settings</a>
          <slot name="header-actions" />
        </nav>
      </div>
    </header>
    <main id="main" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="disclaimer">
          Lectio is a study aid, not Church teaching. Its notes on history and the original languages are researched
          with AI, checked against their sources and reviewed before they appear. The readings themselves open at a
          licensed source.
        </p>
        <p><a href={links.about}>About Lectio and how notes are checked</a></p>
      </div>
    </footer>
  </body>
</html>

<style>
  .band {
    height: var(--band-height);
    background: var(--colour-accent);
  }

  .site-header {
    background: var(--colour-surface);
    border-bottom: var(--rule-width) solid var(--colour-rule);
  }

  .site-header__inner,
  .site-footer__inner,
  .site-main {
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
    padding-block: var(--space-xs);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: var(--weight-strong);
    color: var(--colour-ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .date-title {
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: var(--leading-snug);
    max-width: none;
  }

  .date-title time {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-strong);
  }

  .celebration {
    font-size: var(--step--1);
    color: var(--colour-accent-ink);
  }

  .site-nav {
    display: flex;
    gap: var(--space-2xs);
  }

  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    color: var(--colour-ink);
    text-decoration: none;
    border-radius: var(--radius-m);
    transition: background-color var(--duration-quick) var(--ease-out);
  }

  .site-nav a:hover {
    background: var(--colour-wash);
  }

  .site-main {
    flex: 1;
    padding-block: var(--space-l) var(--space-xl);
  }

  .site-footer {
    background: var(--colour-wash);
    border-top: var(--rule-width) solid var(--colour-rule);
    color: var(--colour-muted);
    font-size: var(--step--1);
  }

  .site-footer__inner {
    padding-block: var(--space-m);
  }

  .site-footer p:last-child {
    margin-bottom: 0;
  }

  .site-footer a {
    color: var(--colour-link);
  }

  @media (max-width: 40rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .date-title {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
