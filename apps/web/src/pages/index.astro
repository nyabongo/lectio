---
/**
 * The Today page, `/`: the day page for the build date in the site time zone (`siteDate`: Nairobi, or
 * `LECTIO_DATE`). A tiny inline script moves to the day page for the device's own date when it differs and the
 * site has it; without JavaScript, a list of the days ahead links to them. Built by src/lib/day.ts.
 */
import DayView from '../components/day/DayView.astro';
import UpcomingDays from '../components/day/UpcomingDays.astro';
import Seo from '../components/seo/Seo.astro';
import { DEFAULT_LOCALE, formatDate, localePath, t } from '../i18n/index.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { dayPageView, todaySwitch, todaySwitchScript, upcomingDays } from '../lib/day.ts';
import type { DayEnv } from '../lib/day.ts';
import { siteContext, siteDate, withBase } from '../lib/site.ts';

const context = siteContext();
const date = siteDate(context.config);
const lang = DEFAULT_LOCALE;
const base = import.meta.env.BASE_URL;
const env: DayEnv = {
  lang,
  messages: { t, formatDate: (locale, day) => formatDate(locale, day) },
  paths: (path) => withBase(base, localePath(lang, path)),
};
const view = dayPageView(env, context, date);
const upcoming = upcomingDays(env, context.repo, date);
const script = todaySwitchScript(todaySwitch(env, context.repo, date));
const siteName = t(lang, 'common.site.name');
---

<BaseLayout
  title={siteName}
  description={view?.description}
  date={view?.date}
  celebration={view?.title}
  colour={view?.colour}
  lang={lang}
>
  <Seo slot="head" title={siteName} description={view?.description} lang={lang} path="" />
  <script is:inline set:html={script} slot="head" />
  {
    view === null ? (
      <section class="today-missing" aria-labelledby="today-heading">
        <p class="eyebrow">{t(lang, 'day.todayHeading')}</p>
        <h1 id="today-heading">{formatDate(lang, date)}</h1>
        <p>{t(lang, 'day.todayMissing')}</p>
      </section>
    ) : (
      <DayView view={view} eyebrow={t(lang, 'day.todayHeading')} />
    )
  }
  <noscript>
    <UpcomingDays heading={t(lang, 'day.upcomingHeading')} days={upcoming} />
  </noscript>
</BaseLayout>
