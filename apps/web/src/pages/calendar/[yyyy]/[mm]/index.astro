---
/**
 * `/calendar/<yyyy>/<mm>/`: one month as a table (a row per week, a column per weekday). Each day the calendar has
 * links to its day page and shows its colour as a dot plus the colour's name, never colour alone; the principal
 * celebration's name shows in the cell on wide screens and in the list under the grid. Prev/next month links.
 * View model: `monthView` in src/lib/calendar-view.ts.
 */
import Seo from '../../../../components/seo/Seo.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { formatDate, localeOf, localePath, shortWeekday, t } from '../../../../i18n/index.ts';
import { colourDotCss, colourLabels, monthPath, monthStaticPaths, monthView } from '../../../../lib/calendar-view.ts';
import type { MonthId } from '../../../../lib/calendar-view.ts';
import { siteRepo } from '../../../../lib/notes-locale.ts';
import { siteContext, siteDate, withBase } from '../../../../lib/site.ts';

export function getStaticPaths() {
  return monthStaticPaths(siteContext().repo);
}

interface Props {
  id: MonthId;
}

const { id } = Astro.props;
const lang = localeOf(Astro.url);
const base = import.meta.env.BASE_URL;
const href = (path: string) => withBase(base, localePath(lang, path));
const { config } = siteContext();
// Notes in the page language where an approved, up-to-date translation exists (L-113).
const repo = siteRepo(lang);
const view = monthView(repo, id, { today: siteDate(config), locale: lang });
const monthName = (date: string) => formatDate(lang, date, { month: 'long', year: 'numeric' });
const title = monthName(view.date);
const description = t(lang, 'calendar.month.description', { month: title });
const colourLabel: Readonly<Record<string, string>> = colourLabels(lang);
const colourName = (colour: string | null) => (colour === null ? '' : (colourLabel[colour] ?? colour));
const dayLabel = (date: string, celebration: string | null, colour: string | null) =>
  t(lang, 'calendar.month.dayLabel', {
    date: formatDate(lang, date),
    celebration: celebration ?? '',
    colour: colourName(colour),
  });
---

<BaseLayout title={title} description={description} lang={lang}>
  <Seo slot="head" title={title} description={description} lang={lang} path={localePath(lang, monthPath(id)).slice(1)} />
  <style slot="head" is:inline set:html={colourDotCss()} />
  <p class="eyebrow"><a href={href('calendar/')}>{t(lang, 'calendar.month.eyebrow')}</a></p>
  <h1>{title}</h1>

  <nav class="month-nav" aria-label={t(lang, 'calendar.month.nav')}>
    {
      view.prev === null ? (
        <span />
      ) : (
        <a href={href(view.prev.path)} rel="prev">
          <span class="dir">← {t(lang, 'calendar.month.prev')}</span>
          <span class="name">{monthName(view.prev.date)}</span>
        </a>
      )
    }
    <a class="all" href={href('calendar/')}>{t(lang, 'calendar.month.allMonths')}</a>
    {
      view.next === null ? (
        <span />
      ) : (
        <a href={href(view.next.path)} rel="next" class="next">
          <span class="dir">{t(lang, 'calendar.month.next')} →</span>
          <span class="name">{monthName(view.next.date)}</span>
        </a>
      )
    }
  </nav>

  {view.dayCount === 0 && <p class="empty">{t(lang, 'calendar.month.empty')}</p>}

  <table class="grid">
    <caption class="visually-hidden">{title}</caption>
    <thead>
      <tr>
        {
          view.weekdays.map((date) => (
            <th scope="col">
              <abbr title={formatDate(lang, date, { weekday: 'long' })}>
                {shortWeekday(lang, date)}
              </abbr>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        view.weeks.map((week) => (
          <tr>
            {week.map((cell) =>
              cell === null ? (
                <td class="pad" />
              ) : (
                <td class:list={{ today: cell.today, listed: cell.listed, missing: cell.path === null }}>
                  {cell.path === null ? (
                    <span class="cell">
                      <span class="num">{cell.day}</span>
                    </span>
                  ) : (
                    <a
                      class="cell"
                      href={href(cell.path)}
                      aria-label={dayLabel(cell.date, cell.celebration, cell.colour)}
                      aria-current={cell.today ? 'date' : undefined}
                    >
                      <span class="num">{cell.day}</span>
                      <span class="colour">
                        <span class="colour-dot" data-colour={cell.colour} aria-hidden="true" />
                        <span class="colour-name">{colourName(cell.colour)}</span>
                      </span>
                      {cell.listed && (
                        <span class="celebration" lang={cell.celebrationLang}>
                          {cell.celebration}
                        </span>
                      )}
                      {cell.today && <span class="today-tag">{t(lang, 'calendar.month.today')}</span>}
                    </a>
                  )}
                </td>
              ),
            )}
          </tr>
        ))
      }
    </tbody>
  </table>

  {
    view.celebrations.length > 0 && (
      <section class="celebrations" aria-labelledby="celebrations">
        <h2 id="celebrations">{t(lang, 'calendar.month.celebrations')}</h2>
        <ul>
          {view.celebrations.map((item) => (
            <li>
              <a href={href(item.path)}>
                <time datetime={item.date}>
                  {shortWeekday(lang, item.date)} {formatDate(lang, item.date, { day: 'numeric' })}
                </time>
                <span class="name" lang={item.nameLang}>{item.name}</span>
                <span class="colour">
                  <span class="colour-dot" data-colour={item.colour} aria-hidden="true" />
                  <span class="colour-name">{colourName(item.colour)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .month-nav {
    display: grid;
    /* minmax(0, …): long month names wrap instead of widening the page at large text sizes. */
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: var(--space-xs);
    margin-block: var(--space-s) var(--space-m);
  }

  .month-nav a {
    min-width: 0;
    overflow-wrap: break-word;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-height: var(--tap-target);
    color: var(--colour-link);
    text-decoration: none;
    font-weight: var(--weight-strong);
  }

  .month-nav .next {
    justify-self: end;
    text-align: end;
  }

  .month-nav .dir {
    font-size: var(--step--2);
    color: var(--colour-muted);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .month-nav .all {
    padding-inline: var(--space-s);
    border: var(--rule-width) solid var(--colour-rule);
    border-radius: 999px;
    font-size: var(--step--1);
  }

  .grid {
    width: 100%;
    border-collapse: separate;
    border-spacing: var(--space-3xs);
    table-layout: fixed;
  }

  .grid th {
    padding-block: var(--space-3xs);
    font-size: var(--step--1);
    font-weight: var(--weight-strong);
    color: var(--colour-muted);
    text-align: center;
  }

  .grid abbr {
    text-decoration: none;
  }

  .grid td {
    height: 6.5rem;
    padding: 0;
    vertical-align: top;
    background: var(--colour-surface);
    border: var(--rule-width) solid var(--colour-rule);
    border-radius: var(--radius-m);
  }

  .grid td.pad {
    background: transparent;
    border-color: transparent;
  }

  .grid td.missing {
    background: transparent;
    border-style: dashed;
  }

  .grid td.today {
    border-color: var(--colour-accent);
    box-shadow: inset 0 var(--band-height) 0 var(--colour-accent);
  }

  .cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    height: 100%;
    padding: var(--space-2xs);
    color: var(--colour-ink);
    text-decoration: none;
    border-radius: var(--radius-m);
    transition: background-color var(--duration-quick) var(--ease-out);
  }

  a.cell:hover {
    background: var(--colour-wash);
  }

  span.cell {
    color: var(--colour-muted);
  }

  .num {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-strong);
    font-variant-numeric: lining-nums tabular-nums;
    line-height: 1;
  }

  .listed .num {
    color: var(--colour-accent-ink);
  }

  .colour {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    font-size: 0.8125rem;
    color: var(--colour-muted);
  }

  .colour-dot {
    flex: none;
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    border: var(--rule-width) solid var(--colour-muted);
  }

  .celebration {
    font-size: var(--step--2);
    line-height: var(--leading-snug);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .today-tag {
    margin-top: auto;
    align-self: flex-start;
    padding: 0 var(--space-3xs);
    font-size: 0.8125rem;
    font-weight: var(--weight-strong);
    background: var(--colour-accent);
    color: var(--colour-on-accent);
    border-radius: var(--radius-s);
  }

  .celebrations {
    margin-top: var(--space-l);
    max-width: var(--measure);
  }

  .celebrations ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .celebrations a {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--tap-target);
    padding: var(--space-2xs) var(--space-s);
    background: var(--colour-surface);
    border: var(--rule-width) solid var(--colour-rule);
    border-radius: var(--radius-m);
    color: var(--colour-ink);
    text-decoration: none;
  }

  .celebrations a:hover {
    background: var(--colour-wash);
  }

  .celebrations time {
    font-weight: var(--weight-strong);
    color: var(--colour-muted);
    font-size: var(--step--1);
  }

  .empty {
    color: var(--colour-muted);
  }

  @media (max-width: 40rem) {
    .grid {
      border-spacing: 2px;
    }

    .grid td {
      height: 5.5rem;
    }

    .cell {
      padding: var(--space-3xs);
      align-items: center;
    }

    .num {
      font-size: var(--step-0);
    }

    .colour {
      flex-direction: column;
      gap: 2px;
    }

    .colour {
      font-size: 0.75rem;
    }

    .celebration {
      display: none;
    }

    .today-tag {
      align-self: center;
      padding: 0 2px;
      font-size: 0.75rem;
    }

    .celebrations a {
      grid-template-columns: 3.5rem 1fr;
    }

    .celebrations a .colour {
      grid-column: 2;
      flex-direction: row;
    }
  }
</style>
