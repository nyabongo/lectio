---
/**
 * The not-found page, built as `404.html` (GitHub Pages serves it for any missing path). It is kept out of search
 * results and the sitemap; its links are absolute and base-aware, so they work from any depth.
 */
import Seo from '../components/seo/Seo.astro';
import { DEFAULT_LOCALE, localePath, t } from '../i18n/index.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/site.ts';

const base = import.meta.env.BASE_URL;
const lang = DEFAULT_LOCALE;
const title = t(lang, 'seo.notFoundTitle');
const description = t(lang, 'seo.notFoundDescription');
---

<BaseLayout title={title} description={description} lang={lang}>
  <Seo slot="head" title={title} description={description} lang={lang} path="404.html" noindex />
  <section class="not-found" aria-labelledby="not-found-heading">
    <p class="eyebrow">{t(lang, 'seo.notFoundEyebrow')}</p>
    <h1 id="not-found-heading">{t(lang, 'seo.notFoundHeading')}</h1>
    <p>{t(lang, 'seo.notFoundBody')}</p>
    <ul class="not-found__links">
      <li><a class="button" href={withBase(base, localePath(lang))}>{t(lang, 'seo.notFoundHome')}</a></li>
      <li><a href={withBase(base, localePath(lang, 'calendar/'))}>{t(lang, 'seo.notFoundCalendar')}</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: var(--measure);
    padding-block: var(--space-l);
  }

  .not-found__links {
    list-style: none;
    margin: var(--space-m) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-m);
  }

  .not-found__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-weight: var(--weight-strong);
    color: var(--colour-link);
  }

  .not-found__links .button {
    padding-inline: var(--space-s);
    border-radius: var(--radius-m);
    background: var(--colour-accent);
    color: var(--colour-on-accent);
    text-decoration: none;
    transition: filter var(--duration-quick) var(--ease-out);
  }

  .not-found__links .button:hover {
    filter: brightness(1.08);
  }
</style>
