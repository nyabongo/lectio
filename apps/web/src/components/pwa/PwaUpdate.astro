---
/**
 * The PWA's page side (L-061), placed once by the base layout: the update-available toast and the script that
 * registers the service worker (`src/sw/client.ts`). The toast is rendered in production builds only, and the
 * script does nothing without it, so `astro dev` never registers a worker. The toast sits in a polite live region
 * that is always present, so it is announced when it appears.
 */
import { t } from '../../i18n/index.ts';
import { SERVICE_WORKER_FILE } from '../../lib/sw-policy.ts';
import { withBase } from '../../lib/site.ts';

export interface Props {
  lang: string;
  /** Render the toast and so register the worker; defaults to production builds. */
  enabled?: boolean;
}

const { lang, enabled = import.meta.env.PROD } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="pwa-region" aria-live="polite">
  {
    enabled && (
      <div
        class="pwa-toast"
        data-pwa-toast
        data-sw-url={withBase(base, SERVICE_WORKER_FILE)}
        data-sw-scope={withBase(base)}
        hidden
      >
        <p class="pwa-toast__message">{t(lang, 'pwa.update.message')}</p>
        <div class="pwa-toast__actions">
          <button type="button" class="pwa-toast__reload" data-pwa-reload>
            {t(lang, 'pwa.update.reload')}
          </button>
          <button type="button" class="pwa-toast__dismiss" data-pwa-dismiss>
            {t(lang, 'pwa.update.dismiss')}
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  import { browserStorage } from '../../lib/settings.ts';
  import { startPwa } from '../../sw/client.ts';
  import type { PwaPage, WorkerContainer } from '../../sw/client.ts';

  void startPwa(document as unknown as PwaPage, {
    navigator: {
      serviceWorker: navigator.serviceWorker as unknown as WorkerContainer | undefined,
      onLine: navigator.onLine,
    },
    location: window.location,
    now: () => new Date(),
    storage: browserStorage(),
  });
</script>

<style>
  .pwa-region {
    position: fixed;
    inset-inline: 0;
    bottom: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: var(--space-s) var(--gutter);
    pointer-events: none;
  }

  .pwa-toast {
    pointer-events: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    max-width: 36rem;
    padding: var(--space-xs) var(--space-s);
    background: var(--colour-surface);
    color: var(--colour-ink);
    border: var(--rule-width) solid var(--colour-rule);
    border-inline-start: var(--band-height) solid var(--colour-accent);
    border-radius: var(--radius-m);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.18);
  }

  .pwa-toast[hidden] {
    display: none;
  }

  .pwa-toast__message {
    margin: 0;
    font-weight: var(--weight-strong);
  }

  .pwa-toast__actions {
    display: flex;
    gap: var(--space-2xs);
  }

  .pwa-toast button {
    min-height: var(--tap-target);
    padding-inline: var(--space-s);
    font: inherit;
    font-weight: var(--weight-strong);
    border-radius: var(--radius-m);
    cursor: pointer;
    transition: filter var(--duration-quick) var(--ease-out);
  }

  .pwa-toast__reload {
    background: var(--colour-accent);
    color: var(--colour-on-accent);
    border: 0;
  }

  .pwa-toast__dismiss {
    background: transparent;
    color: var(--colour-link);
    border: var(--rule-width) solid var(--colour-rule);
  }

  .pwa-toast button:hover {
    filter: brightness(1.08);
  }
</style>
