---
/**
 * Search and social metadata for a page: canonical link, Open Graph, Twitter card, share image and hreflang
 * alternates. Put it in the base layout's `head` slot:
 *
 *   <BaseLayout title={title} description={description}>
 *     <Seo slot="head" title={title} description={description} path="calendar/" />
 *
 * The base layout renders `<title>` and `<meta name="description">` (with `common.site.pageTitle`); this component
 * adds everything else, with strings from `src/i18n/<lang>/seo.json`. The tags are built by `seoTags()` in
 * src/lib/seo.ts.
 *
 * `image` defaults to the page's own share card when it has one (day, reading and insight pages: `ogImageForPage()`
 * in src/lib/og.ts, rendered by src/pages/og/), else to the static brand card beside this file. The canonical URL is
 * `path` in the page's own locale (a page may pass its default-locale path), and `alternates` default to the same
 * page in every site locale plus `x-default` (`localeAlternates()` in src/lib/locales.ts, L-110); noindex pages
 * have none. Share cards are per page, not per locale: a Kiswahili page shows the same English card with the same
 * English alt text (until the cards are localised).
 */
import { DEFAULT_LOCALE, LOCALES, formatDate, localePath, t } from '../../i18n/index.ts';
import { localeAlternates, pathInLocale, splitLocalePath } from '../../lib/locales.ts';
import { ogImageForPage, pageOgTarget } from '../../lib/og.ts';
import { seoTags, stripBase } from '../../lib/seo.ts';
import type { HreflangAlternate, SeoImage } from '../../lib/seo.ts';
import { siteContext, withBase } from '../../lib/site.ts';
import brandCard from './brand-card.png';

export interface Props {
  /** The page title, as passed to the base layout (`common.site.pageTitle` is applied); omit it for the site name. */
  title?: string;
  /** The page summary; defaults to the site description. */
  description?: string;
  /** The page path relative to the base path (`calendar/`); defaults to the current URL. */
  path?: string;
  /** `article` for a reading or a note; `website` otherwise. */
  type?: 'website' | 'article';
  /** Page language; defaults to `en`. */
  lang?: string;
  /** Share image; defaults to the page's share card, else the brand card. */
  image?: SeoImage;
  /** The same page in other locales (hreflang). */
  alternates?: readonly HreflangAlternate[];
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
}

const { title, type, lang = DEFAULT_LOCALE, noindex } = Astro.props;
const description = Astro.props.description ?? t(lang, 'seo.defaultDescription');
const siteName = t(lang, 'common.site.name');
// The same rule as the base layout's <title>.
const fullTitle = title === undefined || title === siteName ? siteName : t(lang, 'common.site.pageTitle', { title });
const base = import.meta.env.BASE_URL;
const neutralPath = splitLocalePath(
  Astro.props.path ?? stripBase(base, Astro.url.pathname),
  LOCALES,
  DEFAULT_LOCALE,
).path;
const path = pathInLocale(lang, neutralPath, DEFAULT_LOCALE);
const alternates =
  Astro.props.alternates ?? (noindex === true ? [] : localeAlternates(neutralPath, LOCALES, DEFAULT_LOCALE));
const site = Astro.site ?? Astro.url;
// Only a day, reading or insight path opens the content repository; the card is the same in every locale.
const pageImage =
  Astro.props.image === undefined && pageOgTarget(neutralPath) !== null
    ? ogImageForPage(
        {
          // The card is rendered once, in the default locale, so its alt text describes it in that language.
          env: {
            lang: DEFAULT_LOCALE,
            messages: { t, formatDate },
            paths: (page: string) => withBase(base, localePath(DEFAULT_LOCALE, page)),
          },
          site,
          base,
          config: siteContext().config,
          repo: siteContext().repo,
        },
        neutralPath,
      )
    : null;
const brandImage: SeoImage = {
  src: brandCard.src,
  width: brandCard.width,
  height: brandCard.height,
  alt: t(lang, 'seo.imageAlt'),
};
const image: SeoImage = Astro.props.image ?? pageImage ?? brandImage;
const tags = seoTags({
  title: fullTitle,
  description,
  path,
  site,
  base,
  locale: lang,
  siteName,
  image,
  type,
  alternates,
  noindex,
});
---

{tags.map(({ tag, attrs }) => (tag === 'link' ? <link {...attrs} /> : <meta {...attrs} />))}
