---
/**
 * The sources behind a note or the Context panel, numbered as the superscripts that cite them. Excerpts carry
 * their language (`lang`, and `dir="rtl"` for Hebrew) so the Greek and Hebrew faces apply.
 */
import { DEFAULT_LOCALE, t } from '../../i18n/index.ts';
import type { SourceView } from '../../lib/reading.ts';

export interface Props {
  sources: readonly SourceView[];
  lang?: string;
}

const { sources, lang = DEFAULT_LOCALE } = Astro.props;
---

<ol class="sources" aria-label={t(lang, 'reading.sources')}>
  {
    sources.map((source) => (
      <li id={source.anchorId} value={source.number} data-source-type={source.type}>
        <span class="sources__citation">
          {source.url === null ? (
            source.citation
          ) : (
            <a href={source.url} rel="noopener external">
              {source.citation}
            </a>
          )}
        </span>
        {source.archivedUrl !== null && (
          <>
            {' '}
            <a class="sources__archived" href={source.archivedUrl} rel="noopener external">
              {t(lang, 'reading.archived')}
            </a>
          </>
        )}
        {source.excerpt !== null && (
          <blockquote class="sources__excerpt" lang={source.excerptLang ?? undefined} dir={source.excerptDir ?? undefined}>
            {source.excerpt}
          </blockquote>
        )}
      </li>
    ))
  }
</ol>

<style>
  .sources {
    margin: 0;
    padding-inline-start: 1.6em;
    display: grid;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--colour-ink);
  }

  .sources li::marker {
    color: var(--colour-accent-ink);
    font-weight: var(--weight-strong);
  }

  .sources li:target {
    background: var(--colour-accent-wash);
    border-radius: var(--radius-s);
  }

  .sources a {
    color: var(--colour-link);
    overflow-wrap: anywhere;
  }

  .sources__archived {
    color: var(--colour-muted);
    white-space: nowrap;
  }

  .sources__excerpt {
    margin: var(--space-3xs) 0 0;
    padding-inline-start: var(--space-xs);
    border-inline-start: 2px solid var(--colour-rule);
    font-size: var(--step-0);
  }
</style>
