# Normalise line endings: every text file is LF in the repo and the working tree.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.woff2 binary
*.bin binary
*.mp3 binary
*.wav binary

# Imported corpora are generated by the importers (L-010, L-011, L-012, L-071):
# hidden from diffs and language stats.
corpus/** linguist-generated -diff
package-lock.json linguist-generated
